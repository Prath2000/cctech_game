{
  "name": "cctech_game",
  "version": "1.0.0",
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "scripts": {
    "preview": "vite preview",
    "dev": "vite",
    "build": "tsc && vite build",
    "build:blockout": "/Applications/Blender.app/Contents/MacOS/Blender -b --python-exit-code 1 -P blender/build_blockout.py",
    "build:props:pantry": "/Applications/Blender.app/Contents/MacOS/Blender -b --python-exit-code 1 -P blender/props/run_pantry.py",
    "build:props:seating": "/Applications/Blender.app/Contents/MacOS/Blender -b --python-exit-code 1 -P blender/props/run_seating.py",
    "typecheck": "tsc --noEmit",
    "check:shot": "tsx scripts/shot.ts",
    "check:walk": "tsx scripts/walk.ts",
    "check:fps": "tsx scripts/fps.ts",
    "check:glb": "python3 scripts/check_glb.py",
    "check:look": "tsx scripts/look.ts",
    "check:grab": "tsx scripts/grab-stress.ts",
    "check:pantry": "tsx scripts/pantry.ts",
    "check:seating": "tsx scripts/seating.ts",
    "build:room": "/Applications/Blender.app/Contents/MacOS/Blender -b --python-exit-code 1 -P blender/build_room.py",
    "fetch:textures": "python3 scripts/fetch_textures.py",
    "build:decals": "python3 scripts/make_decals.py"
  },
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  }
}
